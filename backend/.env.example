PORT=4000
FRONTEND_URL=http://localhost:5173

# Database
MONGO_URL=mongodb://127.0.0.1:27017/food-delivery

# Caching
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
SALT=10

# Payment
STRIPE_SECRET_KEY=sk_test_replace-with-your-stripe-test-key

# Emails
SENDGRID_API_KEY=SG.replace-with-your-sendgrid-api-key
SENDGRID_FROM_EMAIL=no-reply@yourdomain.com

# Default Admin Seed
ADMIN_NAME=Foodaroo Admin
ADMIN_EMAIL=admin@foodaroo.local
ADMIN_PASSWORD=replace-with-at-least-12-character-password

# ----------------------------------------
# AWS S3 Integration (Images)
# ----------------------------------------
USE_S3=true
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your-s3-bucket-name

# ----------------------------------------
# AWS Credentials & Secrets Manager
# ----------------------------------------
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_SECRET_NAME=FoodDeliveryAppSecrets
